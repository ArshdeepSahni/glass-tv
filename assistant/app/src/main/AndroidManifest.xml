<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Asks the desktop what's in front (DeskProvider); both apps are signed with the same key. -->
    <uses-permission android:name="com.gathin.tvhome.permission.DESK" />
    <queries>
        <package android:name="com.gathin.tvhome" />
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
    </queries>
    <application
        android:label="Ask"
        android:icon="@drawable/glass_mark"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Ask">
        <!-- LAUNCHER only (not LEANBACK_LAUNCHER): reached from the remote's assistant key and Hold Home, Down;
             never a tile on Home. -->
        <activity
            android:name=".AskActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The TV's assistant request (android.intent.action.ASSIST), answered here only on a TV where no other app
             answers it. Where Google's assistant is there, the request goes to it and the desktop takes over from its
             screen (the launcher's Takeover): two answers would make Android ask which one, at every press.
             AssistEntry turns this on or off. -->
        <activity-alias
            android:name=".AssistEntry"
            android:targetActivity=".AskActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- Glass as the TV's assistant: the remote's assistant button opens Glass, not Google (set by the installer). -->
        <!-- Glass on a phone: the desktop asks this, for phones the TV allowed; only apps signed like this one may call it -->
        <provider android:name=".ChatProvider" android:authorities="com.gathin.glass.assistant.chat" android:exported="true" />
        <service android:name=".GlassVoiceService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/voice_interaction" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service android:name=".GlassSessionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".GlassRecognitionService" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data android:name="android.speech" android:resource="@xml/recognizer" />
        </service>
    </application>
</manifest>
